REACT_APP_FIREBASE_API_KEY=
REACT_APP_FIREBASE_AUTH_DOMAIN=
REACT_APP_FIREBASE_PROJECT_ID=
REACT_APP_FIREBASE_STORAGE_BUCKET=
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=
REACT_APP_FIREBASE_APP_ID=

# Local-only Firebase suite. Keep false when using the real project.
REACT_APP_USE_FIREBASE_EMULATORS=false

# App Check: leave empty locally until the web app is registered in Firebase.
REACT_APP_FIREBASE_APP_CHECK_SITE_KEY=
# Use only in local development, never in production.
REACT_APP_FIREBASE_APP_CHECK_DEBUG_TOKEN=false

# Server-only variables (configure in the deployment environment, not in React).
FIREBASE_PROJECT_ID=
ANTHROPIC_API_KEY=
# Paid AI is intentionally disabled unless this is explicitly true.
ENABLE_PAID_AI=false
AI_REQUESTS_PER_MINUTE=6
AI_MAX_OUTPUT_TOKENS=1024
